# Database Connection (Neon PgBouncer pooler URL)
# The application automatically adapts postgresql:// into postgresql+asyncpg://
DATABASE_URL=postgresql://neondb_owner:<password>@<pooler-host>/simpleeras?sslmode=require&channel_binding=require

# Authentication & Security
# Required, at least 32 characters. The API refuses to start with this placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Background jobs
ESCALATION_SWEEP_INTERVAL_SECS=60
NOTIFICATION_DISPATCH_INTERVAL_SECS=30
# disabled: leave escalation notifications queued and log a warning
# log:      write each notification to the application log and mark it sent
NOTIFICATION_PROVIDER=disabled

# Patient WhatsApp messages (reminders, check-in replies)
# disabled: leave them queued and log a warning
# log:      write one line per message (no patient details) and mark it sent
# meta:     send approved templates through Meta's Graph API
WHATSAPP_PROVIDER=disabled
DAILY_DISPATCH_INTERVAL_SECS=60
# Optional platform number, used for a hospital that has not connected its own
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Signs Meta's webhook calls; without it every webhook POST is refused
META_APP_SECRET=
# Optional; each connected hospital's own verify token is accepted too
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v21.0
# Where patients open their check-in link, and where Meta reaches the webhook
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
